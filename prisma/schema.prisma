// Prisma schema — ReparaJá
// Fase 1: utilizadores, autenticação e escalões de comissão.
// Fase 2: pedidos, orçamentos com linhas e trabalhos contratados.
// Fase 3: pagamentos — APENAS SIMULADOS (provider "mock"). Não há nenhuma
// integração real com Stripe ou outro processador. Ver src/lib/payments.
// Fase 4: chat com deteção de contactos externos.
// Disputas entram numa fase seguinte.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENTE
  PROFISSIONAL
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole
  location     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  professionalProfile ProfessionalProfile?

  requests         ServiceRequest[] @relation("ClientRequests")
  quotes           Quote[]          @relation("ProfessionalQuotes")
  jobsAsClient     Job[]            @relation("ClientJobs")
  jobsAsProfessional Job[]          @relation("ProfessionalJobs")
  payouts          Payout[]

  conversationsAsClient       Conversation[] @relation("ClientConversations")
  conversationsAsProfessional Conversation[] @relation("ProfessionalConversations")
  messages                    Message[]

  @@map("users")
}

// Dados específicos de quem presta serviços. Campos de Stripe Connect e
// verificação (KYC/KYB) ficam como placeholders para a Fase 3 — nada aqui
// simula onboarding ou verificação real.
model ProfessionalProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                String?
  specialties         String[]  @default([])
  verified           Boolean   @default(false)
  stripeAccountId    String?
  stripeOnboardedAt  DateTime?

  // Coordenadas aproximadas para o mapa "profissionais perto de si".
  // Preenchidas por geocodificação best-effort a partir de `location`
  // (ver src/lib/geocoding.ts) — podem ficar a null se a geocodificação
  // falhar ou o profissional não tiver indicado localização.
  latitude           Float?
  longitude          Float?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("professional_profiles")
}

// Escalões de comissão progressiva. Configuráveis, nunca hardcoded no código.
// applicableUpTo = null significa "sem limite superior" (último escalão).
model CommissionTier {
  id             String    @id @default(cuid())
  applicableFrom Decimal   @db.Decimal(12, 2)
  applicableUpTo Decimal?  @db.Decimal(12, 2)
  rate           Decimal   @db.Decimal(5, 4) // ex: 0.10 = 10%
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@map("commission_tiers")
}

enum ServiceCategory {
  REMODELACAO
  PINTURA
  CANALIZACAO
  ELETRICIDADE
  CARPINTARIA
  PAVIMENTO
  COZINHA
  CASA_BANHO
  OUTRO
}

enum RequestTiming {
  ESTA_SEMANA
  PROXIMAS_DUAS_SEMANAS
  ESTE_MES
  SEM_URGENCIA
}

enum RequestStatus {
  ABERTO
  FECHADO
  CANCELADO
}

// Pedido de orçamento publicado pelo cliente. Fica ABERTO a receber
// orçamentos até o cliente aceitar um ou fechar/cancelar o pedido.
model ServiceRequest {
  id          String          @id @default(cuid())
  clientId    String
  client      User            @relation("ClientRequests", fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    ServiceCategory
  location    String?
  budgetMin   Decimal?        @db.Decimal(12, 2)
  budgetMax   Decimal?        @db.Decimal(12, 2)
  timing      RequestTiming   @default(SEM_URGENCIA)
  status      RequestStatus   @default(ABERTO)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  quotes        Quote[]
  jobs          Job[]
  conversations Conversation[]

  @@map("service_requests")
}

// Tipo de linha de orçamento. Lista fixa pedida para permitir ao
// profissional montar um orçamento por toques rápidos, sem escrever tudo.
enum QuoteItemType {
  MAO_DE_OBRA
  DESLOCACAO
  MATERIAIS
  DEMOLICAO
  PREPARACAO
  INSTALACAO
  TRANSPORTE
  LIMPEZA
  ALUGUER_EQUIPAMENTO
  OUTRO
}

enum QuoteStatus {
  ENVIADO
  ACEITE
  RECUSADO
  EXPIRADO
}

// Orçamento enviado por um profissional para um pedido. Imutável depois de
// enviado — uma alteração de preço gera um novo orçamento (histórico
// completo fica sempre visível, nunca se substitui silenciosamente um valor).
model Quote {
  id             String      @id @default(cuid())
  requestId      String
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  professionalId String
  professional   User        @relation("ProfessionalQuotes", fields: [professionalId], references: [id], onDelete: Cascade)
  notes          String?
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  vatEnabled     Boolean     @default(false)
  vatRate        Decimal?    @db.Decimal(5, 4)
  subtotal       Decimal     @db.Decimal(12, 2)
  taxableBase    Decimal     @db.Decimal(12, 2)
  vatAmount      Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  validUntil     DateTime?
  status         QuoteStatus @default(ENVIADO)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items QuoteItem[]
  job   Job?

  @@index([requestId])
  @@index([professionalId])
  @@map("quotes")
}

model QuoteItem {
  id          String        @id @default(cuid())
  quoteId     String
  quote       Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type        QuoteItemType
  description String
  quantity    Decimal       @db.Decimal(10, 2)
  unit        String
  unitPrice   Decimal       @db.Decimal(12, 2)
  lineTotal   Decimal       @db.Decimal(12, 2)
  position    Int           @default(0)

  @@map("quote_items")
}

enum JobStatus {
  AGUARDA_PAGAMENTO
  EM_CURSO
  CONCLUIDO
  CANCELADO
}

// Trabalho contratado, criado quando o cliente aceita um orçamento.
// Fica AGUARDA_PAGAMENTO até a Fase 3 (Stripe Connect) processar o
// pagamento real — nada aqui deve sugerir que dinheiro já foi cobrado.
model Job {
  id             String    @id @default(cuid())
  requestId      String
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quoteId        String    @unique
  quote          Quote     @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  clientId       String
  client         User      @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Restrict)
  professionalId String
  professional   User      @relation("ProfessionalJobs", fields: [professionalId], references: [id], onDelete: Restrict)
  status         JobStatus @default(AGUARDA_PAGAMENTO)

  // Snapshot financeiro no momento da contratação — nunca recalculado
  // retroativamente se os escalões de comissão mudarem no futuro.
  agreedTotal                Decimal @db.Decimal(12, 2)
  commissionApplicableAmount Decimal @db.Decimal(12, 2)
  commissionAmount           Decimal @db.Decimal(12, 2)
  commissionBreakdown        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment?
  payout  Payout?

  @@map("jobs")
}

enum PaymentStatus {
  PENDENTE
  CONFIRMADO
  FALHADO
  REEMBOLSADO
}

// Pagamento do cliente associado a um trabalho. `provider` identifica quem
// processou — hoje é sempre "mock" (ver src/lib/payments/mock-provider.ts).
// Não existe nenhuma integração real: confirmar/falhar aqui é uma ação
// manual no ecrã a simular o que seria um webhook do processador real.
model Payment {
  id                String        @id @default(cuid())
  jobId             String        @unique
  job               Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  amount            Decimal       @db.Decimal(12, 2)
  provider          String        @default("mock")
  providerReference String?
  status            PaymentStatus @default(PENDENTE)
  createdAt         DateTime      @default(now())
  confirmedAt       DateTime?
  failedAt          DateTime?

  @@map("payments")
}

enum PayoutStatus {
  PENDENTE
  LIBERTADO
  FALHADO
}

// Transferência simulada ao profissional, criada quando o cliente confirma
// a conclusão do trabalho. `amount` é sempre agreedTotal - commissionAmount,
// nunca recalculado à parte.
model Payout {
  id                String       @id @default(cuid())
  jobId             String       @unique
  job               Job          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  professionalId    String
  professional      User         @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  amount            Decimal      @db.Decimal(12, 2)
  provider          String       @default("mock")
  providerReference String?
  status            PayoutStatus @default(PENDENTE)
  createdAt         DateTime     @default(now())
  releasedAt        DateTime?

  @@map("payouts")
}

// Uma conversa por par (pedido, profissional) — o cliente é sempre o dono
// do pedido. Continua a mesma conversa antes e depois da contratação; a UI
// é que muda o contexto mostrado ("Pedido" -> "Trabalho") consoante exista
// ou não um Job para este par. Nunca se cria uma segunda conversa para o
// mesmo par: histórico completo fica sempre no mesmo sítio.
model Conversation {
  id             String   @id @default(cuid())
  requestId      String
  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  clientId       String
  client         User     @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   User     @relation("ProfessionalConversations", fields: [professionalId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  lastMessageAt  DateTime @default(now())

  messages Message[]

  @@unique([requestId, professionalId])
  @@index([clientId])
  @@index([professionalId])
  @@map("conversations")
}

enum MessageKind {
  TEXT
  SYSTEM
}

// Mensagens de sistema (kind=SYSTEM, senderId=null) criam o histórico
// cronológico auditável da contratação — inseridas automaticamente pelo
// backend nos pontos-chave (orçamento enviado/aceite/recusado, pagamento
// confirmado/falhado, trabalho concluído). Nunca incluem valores de
// comissão: a conversa é partilhada pelas duas partes, e o cliente não
// pode saber a comissão (ver src/lib/serialize.ts).
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  kind           MessageKind  @default(TEXT)
  body           String?
  systemType     String?
  systemPayload  Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Registo mínimo de tentativas de partilha de contacto externo bloqueadas
// (ver src/lib/contact-detection.ts) — só o tipo de padrão, nunca o texto
// bloqueado, para não guardar números/emails de terceiros sem necessidade.
// Serve de base para a métrica "tentativas de partilha de contactos
// externos" (Fase 5).
model ContactAttemptLog {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  patternType    String
  createdAt      DateTime @default(now())

  @@map("contact_attempt_logs")
}
